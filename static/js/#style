 /* ============================================================
       VARIABLES & RESET
       Palette : fond sombre ardoise + accent vert émeraude vif
    ============================================================ */
    :root {
      --bg:          #0f1117;
      --surface:     #181c27;
      --surface-2:   #1f2436;
      --border:      #2a3045;
      --accent:      #00d68f;
      --accent-dim:  #00d68f22;
      --accent-glow: #00d68f44;
      --amber:       #f5a623;
      --red:         #ff5c5c;
      --text-1:      #eef0f6;
      --text-2:      #8891aa;
      --text-3:      #4a5168;
      --radius-sm:   8px;
      --radius-md:   14px;
      --radius-lg:   22px;
      --shadow:      0 8px 40px #00000060;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text-1);
      font-family: 'DM Sans', sans-serif;
      font-size: 15px;
      line-height: 1.65;
      min-height: 100vh;
      /* Texture subtile : grille de points */
      background-image: radial-gradient(circle, #ffffff08 1px, transparent 1px);
      background-size: 28px 28px;
    }

    /* ============================================================
       LAYOUT PRINCIPAL
    ============================================================ */
    .page-wrapper {
      max-width: 960px;
      margin: 0 auto;
      padding: 3rem 1.5rem 6rem;
    }

    /* ============================================================
       EN-TÊTE
    ============================================================ */
    .page-header {
      margin-bottom: 3rem;
      position: relative;
    }

    .logo-line {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 1rem;
    }

    .logo-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px var(--accent);
    }

    .logo-text {
      font-family: 'DM Serif Display', serif;
      font-size: 1.1rem;
      color: var(--accent);
      letter-spacing: 0.03em;
    }

    .page-title {
      font-family: 'DM Serif Display', serif;
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 400;
      line-height: 1.15;
      color: var(--text-1);
    }

    .page-title em {
      font-style: italic;
      color: var(--accent);
    }

    .page-subtitle {
      margin-top: 0.75rem;
      color: var(--text-2);
      font-weight: 300;
      max-width: 520px;
    }

    /* Ligne décorative */
    .page-header::after {
      content: '';
      display: block;
      margin-top: 2rem;
      height: 1px;
      background: linear-gradient(90deg, var(--accent) 0%, transparent 70%);
    }

    /* ============================================================
       SECTION : GRILLE DES MATIÈRES
    ============================================================ */
    .section-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      color: var(--text-3);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .subjects-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 3rem;
    }

    /* Bouton matière */
    .subject-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 100px;   /* pill */
      color: var(--text-2);
      font-family: 'DM Sans', sans-serif;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      outline: none;
      position: relative;
      overflow: hidden;
    }

    /* Brillance au survol */
    .subject-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--accent-dim);
      opacity: 0;
      transition: opacity 0.2s;
    }

    .subject-btn:hover::before { opacity: 1; }
    .subject-btn:hover {
      border-color: var(--accent);
      color: var(--text-1);
      transform: translateY(-2px);
      box-shadow: 0 4px 20px var(--accent-glow);
    }

    /* État actif / sélectionné */
    .subject-btn.active {
      background: var(--accent-dim);
      border-color: var(--accent);
      color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .subject-btn .btn-icon {
      font-size: 1rem;
      line-height: 1;
    }

    /* ============================================================
       ZONE D'AFFICHAGE DES RÉSULTATS
    ============================================================ */
    #results-section { min-height: 200px; }

    /* En-tête du résultat */
    .results-header {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 1.5rem;
      animation: fadeSlideDown 0.4s ease both;
    }

    .results-title {
      font-family: 'DM Serif Display', serif;
      font-size: 1.4rem;
      color: var(--text-1);
    }

    .results-count {
      font-size: 0.8rem;
      color: var(--text-3);
      background: var(--surface-2);
      padding: 2px 10px;
      border-radius: 100px;
    }

    /* Grille de cartes */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }

    /* ============================================================
       CARTE MENTOR
    ============================================================ */
    .mentor-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
      transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
      animation: fadeSlideUp 0.4s ease both;
    }

    .mentor-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--shadow);
      border-color: var(--accent);
    }

    /* Lueur verte subtile en bas des cartes au hover */
    .mentor-card::after {
      content: '';
      position: absolute;
      bottom: -30px;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      height: 60px;
      background: var(--accent);
      filter: blur(30px);
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    .mentor-card:hover::after { opacity: 0.15; }

    /* Carte TOP : bordure accentuée + fond légèrement teinté */
    .mentor-card.top-mentor {
      border-color: var(--accent);
      background: linear-gradient(145deg, var(--surface) 60%, #00d68f12);
    }

    /* Badge "Top Mentor" / "Recommandé" */
    .mentor-badge {
      position: absolute;
      top: 16px;
      right: 16px;
      padding: 4px 12px;
      border-radius: 100px;
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .badge-top {
      background: var(--accent);
      color: #0f1117;
    }

    .badge-recommended {
      background: var(--surface-2);
      border: 1px solid var(--border);
      color: var(--text-2);
    }

    /* Avatar / initiales */
    .mentor-avatar {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--surface-2);
      border: 2px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'DM Serif Display', serif;
      font-size: 1.1rem;
      color: var(--accent);
      margin-bottom: 0.85rem;
      flex-shrink: 0;
    }

    .mentor-card.top-mentor .mentor-avatar {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px var(--accent-glow);
    }

    /* Nom */
    .mentor-name {
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--text-1);
      margin-bottom: 2px;
      padding-right: 70px; /* espace pour le badge */
    }

    /* Matière principale */
    .mentor-subject {
      font-size: 0.78rem;
      color: var(--accent);
      font-weight: 500;
      margin-bottom: 0.6rem;
    }

    /* Biographie courte */
    .mentor-bio {
      font-size: 0.82rem;
      color: var(--text-2);
      font-weight: 300;
      margin-bottom: 1.1rem;
      line-height: 1.55;
    }

    /* Séparateur */
    .card-divider {
      height: 1px;
      background: var(--border);
      margin-bottom: 1rem;
    }

    /* Statistiques en ligne */
    .mentor-stats {
      display: flex;
      align-items: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1px;
    }

    .stat-value {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-1);
    }

    .stat-label {
      font-size: 0.68rem;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    /* Barre de score de fiabilité */
    .reliability-bar-wrapper {
      margin-top: 1rem;
    }

    .reliability-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.72rem;
      color: var(--text-3);
      margin-bottom: 5px;
    }

    .reliability-label span:last-child {
      color: var(--accent);
      font-weight: 600;
    }

    .reliability-bar {
      height: 4px;
      border-radius: 4px;
      background: var(--surface-2);
      overflow: hidden;
    }

    .reliability-fill {
      height: 100%;
      border-radius: 4px;
      background: linear-gradient(90deg, #00b87a, var(--accent));
      transition: width 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
      width: 0%; /* animé via JS */
    }

    /* Étoiles */
    .stars {
      display: flex;
      gap: 2px;
      margin-bottom: 0.1rem;
    }

    .star {
      width: 12px;
      height: 12px;
      fill: var(--amber);
    }

    .star.empty { fill: var(--border); }

    /* Tag de disponibilité */
    .availability-tag {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 100px;
      font-size: 0.7rem;
      font-weight: 500;
      margin-top: 0.85rem;
    }

    .tag-available {
      background: #00d68f18;
      color: var(--accent);
      border: 1px solid #00d68f33;
    }

    .tag-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    /* ============================================================
       ÉTAT VIDE
    ============================================================ */
    .empty-state {
      grid-column: 1 / -1;
      text-align: center;
      padding: 4rem 2rem;
      animation: fadeSlideUp 0.4s ease both;
    }

    .empty-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      display: block;
      opacity: 0.4;
    }

    .empty-title {
      font-family: 'DM Serif Display', serif;
      font-size: 1.3rem;
      color: var(--text-1);
      margin-bottom: 0.5rem;
    }

    .empty-msg {
      color: var(--text-2);
      font-weight: 300;
      max-width: 360px;
      margin: 0 auto;
    }

    /* ============================================================
       ÉTAT INITIAL (avant sélection)
    ============================================================ */
    .initial-state {
      text-align: center;
      padding: 4rem 1rem;
      color: var(--text-3);
      font-size: 0.9rem;
    }

    .initial-state .big-icon { font-size: 2.5rem; margin-bottom: 0.75rem; display: block; }

    /* ============================================================
       ANIMATIONS
    ============================================================ */
    @keyframes fadeSlideUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeSlideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* Délais d'apparition en cascade pour les cartes */
    .cards-grid .mentor-card:nth-child(1) { animation-delay: 0.05s; }
    .cards-grid .mentor-card:nth-child(2) { animation-delay: 0.12s; }
    .cards-grid .mentor-card:nth-child(3) { animation-delay: 0.19s; }
    .cards-grid .mentor-card:nth-child(4) { animation-delay: 0.26s; }
    .cards-grid .mentor-card:nth-child(5) { animation-delay: 0.33s; }
    .cards-grid .mentor-card:nth-child(6) { animation-delay: 0.40s; }

    /* ============================================================
       RESPONSIVE
    ============================================================ */
    @media (max-width: 600px) {
      .page-title { font-size: 1.8rem; }
      .cards-grid { grid-template-columns: 1fr; }
    }
 
